<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppListaTelefonica.Views.RecuperacaoPasswordWindow"
        Title="Recuperar Palavra-passe"
        Width="450" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

	<StackPanel Margin="30" Spacing="15">

		<!-- Título -->
		<TextBlock Text="Recuperar Palavra-passe"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

		<TextBlock Text="Código de verificação" FontWeight="Bold"/>
		<TextBox x:Name="CodigoBox"
                 Watermark="000000"
                 MaxLength="6"
                 TextAlignment="Center"
                 FontSize="16"/>

		<TextBlock Text="Nova palavra-passe" FontWeight="Bold" Margin="0,10,0,0"/>
		<PasswordBox x:Name="NovaPasswordBox" Watermark="********"/>

		<!-- Indicador de força -->
		<Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,5,0,0">
			<StackPanel Spacing="8">
				<ProgressBar x:Name="StrengthBar"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             CornerRadius="2"/>
				<TextBlock x:Name="StrengthText"
                           FontSize="11"
                           Foreground="#6B7280"
                           Text="Força da palavra-passe"/>
			</StackPanel>
		</Border>

		<TextBlock Text="Confirmar nova palavra-passe" FontWeight="Bold" Margin="0,10,0,0"/>
		<PasswordBox x:Name="ConfirmPasswordBox" Watermark="********"/>

		<Button x:Name="RecuperarButton"
                Content="Redefinir Palavra-passe"
                Background="#4F46E5"
                Foreground="White"
                Padding="12"
                CornerRadius="8"
                Margin="0,20,0,0"/>

		<!-- Mensagem de erro -->
		<Border x:Name="ErrorBorder"
                Background="#FEE2E2"
                BorderBrush="#EF4444"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                IsVisible="False">
			<TextBlock x:Name="ErrorText"
                       Foreground="#DC2626"
                       FontSize="12"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
		</Border>
	</StackPanel>
</Window>