<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppListaTelefonica.Views.VerificacaoEmailWindow"
        Title="Verificar Email - ListaTel"
        Width="400" Height="380"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#1B5E8A" CornerRadius="7" Width="32" Height="32">
                    <TextBlock Text="LT" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
                <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Foreground="#111827">
                    Lista<Run Foreground="#1B5E8A" FontWeight="Bold">Tel</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="40,30" Spacing="20" VerticalAlignment="Center">
                
                <StackPanel Spacing="4">
                    <TextBlock Text="Verificar Email" FontSize="22" FontWeight="Medium" Foreground="#111827"/>
                    <TextBlock Text="Introduza o codigo de 6 digitos enviado para o seu email" 
                               FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Codigo -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Codigo de verificacao" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                        <TextBox Name="TxtCodigo" PlaceholderText="000000" MaxLength="6"
                                 Padding="12,10" BorderThickness="0" Background="Transparent"
                                 FontSize="18" HorizontalContentAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Mensagens -->
                <Border Name="BorderErro" Background="#FEF2F2" BorderBrush="#FCA5A5" 
                        BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                    <TextBlock Name="TxtErro" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                </Border>
                <Border Name="BorderSucesso" Background="#F0FDF4" BorderBrush="#86EFAC" 
                        BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                    <TextBlock Name="TxtSucesso" Foreground="#16A34A" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Botoes -->
                <StackPanel Spacing="10">
                    <Button Name="BtnVerificar" Content="Verificar" Background="#1B5E8A" 
                            Foreground="White" Padding="14,10" FontWeight="Medium" FontSize="13"
                            CornerRadius="6" Click="BtnVerificar_Click"/>
                    
                    <Button Name="BtnReenviar" Content="Reenviar Codigo" Background="Transparent" 
                            Foreground="#1B5E8A" Padding="14,10" FontSize="12"
                            Click="BtnReenviar_Click" HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>