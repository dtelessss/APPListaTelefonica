<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppListaTelefonica.Views.RecuperacaoPasswordWindow"
        Title="Recuperar Password - ListaTel"
        Width="420" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#1B5E8A" CornerRadius="7" Width="32" Height="32">
                    <TextBlock Text="LT" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
                <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Foreground="#111827">
                    Lista<Run Foreground="#1B5E8A" FontWeight="Bold">Tel</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Conteudo -->
        <ScrollViewer Grid.Row="1">
            <Grid>
                <!-- Painel 1: Solicitar recuperacao -->
                <StackPanel Name="PainelSolicitar" Margin="40,30" Spacing="20" VerticalAlignment="Center">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Recuperar Password" FontSize="22" FontWeight="Medium" Foreground="#111827"/>
                        <TextBlock Text="Introduza o seu email para receber um codigo de recuperacao" 
                                   FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Email profissional" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                            <TextBox Name="TxtEmail" PlaceholderText="exemplo@organizacao.pt" 
                                     Padding="12,10" BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </StackPanel>

                    <Border Name="BorderErroSolicitar" Background="#FEF2F2" BorderBrush="#FCA5A5" 
                            BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                        <TextBlock Name="TxtErroSolicitar" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <Border Name="BorderSucessoSolicitar" Background="#F0FDF4" BorderBrush="#86EFAC" 
                            BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                        <TextBlock Name="TxtSucessoSolicitar" Foreground="#16A34A" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Spacing="10">
                        <Button Name="BtnSolicitar" Content="Enviar Codigo" Background="#1B5E8A" 
                                Foreground="White" Padding="14,10" FontWeight="Medium" FontSize="13"
                                CornerRadius="6" Click="BtnSolicitar_Click"/>
                        
                        <Button Name="BtnCancelar1" Content="Voltar" Background="Transparent" 
                                Foreground="#374151" Padding="14,10" FontSize="13"
                                BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" 
                                Click="BtnCancelar_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Painel 2: Nova password -->
                <StackPanel Name="PainelNovaPassword" Margin="40,30" Spacing="16" VerticalAlignment="Center" IsVisible="False">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Nova Password" FontSize="22" FontWeight="Medium" Foreground="#111827"/>
                        <TextBlock Text="Introduza o codigo recebido e a nova password" 
                                   FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Codigo de recuperacao" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                            <TextBox Name="TxtCodigo" PlaceholderText="000000" MaxLength="6"
                                     Padding="12,10" BorderThickness="0" Background="Transparent"
                                     FontSize="18" HorizontalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Nova palavra-passe" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                            <TextBox Name="TxtNovaPassword" PasswordChar="●" 
                                     PlaceholderText="••••••••••••" Padding="12,10" 
                                     BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Confirmar nova palavra-passe" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                            <TextBox Name="TxtConfirmarPassword" PasswordChar="●" 
                                     PlaceholderText="••••••••••••" Padding="12,10" 
                                     BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </StackPanel>

                    <Border Name="BorderErroNova" Background="#FEF2F2" BorderBrush="#FCA5A5" 
                            BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                        <TextBlock Name="TxtErroNova" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <Border Name="BorderSucessoNova" Background="#F0FDF4" BorderBrush="#86EFAC" 
                            BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                        <TextBlock Name="TxtSucessoNova" Foreground="#16A34A" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Spacing="10">
                        <Button Name="BtnAlterarPassword" Content="Alterar Password" Background="#1B5E8A" 
                                Foreground="White" Padding="14,10" FontWeight="Medium" FontSize="13"
                                CornerRadius="6" Click="BtnAlterarPassword_Click"/>
                        
                        <Button Name="BtnCancelar2" Content="Voltar" Background="Transparent" 
                                Foreground="#374151" Padding="14,10" FontSize="13"
                                BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" 
                                Click="BtnCancelar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>