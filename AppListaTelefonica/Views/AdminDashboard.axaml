<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:AppListaTelefonica.Models"
        x:Class="AppListaTelefonica.Views.AdminDashboard"
        Title="Painel de Administracao - ListaTel"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="8" Width="36" Height="36">
                        <TextBlock Text="LT" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Painel de Administracao" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Name="TxtAdminEmail" Text="admin@org.pt" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="BtnVoltar" Content="Voltar a ListaTel" Background="Transparent" 
                            Foreground="#475569" Padding="12,8" BorderBrush="#CBD5E1" BorderThickness="1"
                            CornerRadius="6" FontSize="12" Click="BtnVoltar_Click"/>
                    <Button Name="BtnTerminarSessao" Content="Terminar Sessao" Background="#EF4444" 
                            Foreground="White" Padding="12,8" CornerRadius="6" FontSize="12" Click="BtnTerminarSessao_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conteudo -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24" Spacing="24">
                
                <!-- Cards de Estatisticas -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="16">
                    
                    <!-- Card Utilizadores -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Utilizadores" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Name="TxtTotalUtilizadores" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                <TextBlock Name="TxtDistribuicao" Text="0 admins / 0 normais" FontSize="11" Foreground="#3B82F6"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card Admins -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Administradores" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Name="TxtTotalAdmins" Text="0" FontSize="28" FontWeight="Bold" Foreground="#8B5CF6"/>
                            <Border Background="#F5F3FF" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                <TextBlock Text="Gestao total" FontSize="11" Foreground="#8B5CF6"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card Contactos Publicos -->
                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Contactos Publicos" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Name="TxtTotalPublicos" Text="0" FontSize="28" FontWeight="Bold" Foreground="#10B981"/>
                            <Border Background="#ECFDF5" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                <TextBlock Text="Lista publica" FontSize="11" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card Contactos Privados -->
                    <Border Grid.Column="3" Background="White" CornerRadius="10" Padding="20" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Contactos Privados" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Name="TxtTotalPrivados" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F59E0B"/>
                            <Border Background="#FFFBEB" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                <TextBlock Text="Todos os users" FontSize="11" Foreground="#F59E0B"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Grafico de Barras Simples + Tabela -->
                <Grid ColumnDefinitions="1.2*, 2*" ColumnSpacing="16">
                    
                    <!-- Grafico -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Distribuicao de Utilizadores" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                            
                            <!-- Barra Admins -->
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <TextBlock Text="Administradores" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Name="TxtPercentAdmins" Text="0%" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="#8B5CF6"/>
                                </DockPanel>
                                <Border Background="#F1F5F9" CornerRadius="4" Height="8">
                                    <Border Name="BarAdmins" Background="#8B5CF6" CornerRadius="4" Width="0" Height="8"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Barra Normais -->
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <TextBlock Text="Normais" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Name="TxtPercentNormais" Text="0%" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                </DockPanel>
                                <Border Background="#F1F5F9" CornerRadius="4" Height="8">
                                    <Border Name="BarNormais" Background="#3B82F6" CornerRadius="4" Width="0" Height="8"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Barra Contactos -->
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <TextBlock Text="C. Publicos / Privados" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Name="TxtPercentContactos" Text="0 / 0" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                                </DockPanel>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="4">
                                    <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="4" Height="8">
                                        <Border Name="BarPublicos" Background="#10B981" CornerRadius="4" Width="0" Height="8" HorizontalAlignment="Left"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Height="8">
                                        <Border Name="BarPrivados" Background="#F59E0B" CornerRadius="4" Width="0" Height="8" HorizontalAlignment="Left"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tabela de Utilizadores -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" 
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <DockPanel>
                                <TextBlock Text="Utilizadores Registados" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Name="TxtTotalTabela" Text="0 total" DockPanel.Dock="Right" FontSize="12" Foreground="#64748B"/>
                            </DockPanel>
                            
                            <ScrollViewer Height="250">
                                <DataGrid Name="GridUtilizadores" AutoGenerateColumns="False" 
                                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          x:DataType="models:Utilizador">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                                        <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="1*"/>
                                        <DataGridTextColumn Header="U. Organica" Binding="{Binding UnidadeOrganica}" Width="1.5*"/>
                                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="0.7*"/>
                                        <DataGridCheckBoxColumn Header="Verificado" Binding="{Binding EmailVerificado}" Width="0.8*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Navegacao rapida -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16">
                    <Button Grid.Column="0" Name="BtnGerirPublicos" Content="Gerir Contactos Publicos" 
                            Background="White" Foreground="#0F172A" Padding="20,14" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13" Click="BtnGerirPublicos_Click"/>
                    <Button Grid.Column="1" Name="BtnGerirUtilizadores" Content="Gerir Utilizadores" 
                            Background="White" Foreground="#0F172A" Padding="20,14" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13" Click="BtnGerirUtilizadores_Click"/>
                    <Button Grid.Column="2" Name="BtnConfiguracoes" Content="Configuracoes da Aplicacao" 
                            Background="White" Foreground="#0F172A" Padding="20,14" CornerRadius="10"
                            BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13" Click="BtnConfiguracoes_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>