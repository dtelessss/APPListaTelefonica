<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppListaTelefonica.Views.ConfiguracoesAppWindow"
        Title="Configuracoes da Aplicacao - ListaTel"
        Width="600" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <DockPanel>
                <TextBlock Text="Configuracoes da Aplicacao" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Name="BtnVoltar" Content="Voltar" Background="Transparent" 
                        Foreground="#475569" Padding="12,8" BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="6" FontSize="12" Click="BtnVoltar_Click"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24">
            <StackPanel Spacing="20">
                
                <!-- Email -->
                <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Configuracoes de Email (SMTP)" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Servidor SMTP" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtServidorSmtp" PlaceholderText="smtp.organizacao.pt" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Porta" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtPortaSmtp" PlaceholderText="587" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Email" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtEmailSmtp" PlaceholderText="no-reply@organizacao.pt" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Password" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtPasswordSmtp" PasswordChar="●" PlaceholderText="Password SMTP" Padding="10,8"/>
                        </StackPanel>
                        <Button Name="BtnGuardarEmail" Content="Guardar Configuracoes de Email" Background="#1B5E8A" 
                                Foreground="White" Padding="14,10" CornerRadius="6" FontSize="12" Click="BtnGuardarEmail_Click"/>
                    </StackPanel>
                </Border>

                <!-- Sessao -->
                <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Duracao da Sessao" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Dias de sessao ativa" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtDuracaoSessao" PlaceholderText="7" Padding="10,8"/>
                            <TextBlock Text="Minimo 1 dia, maximo 365 dias" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                        <Button Name="BtnGuardarSessao" Content="Guardar Duracao da Sessao" Background="#1B5E8A" 
                                Foreground="White" Padding="14,10" CornerRadius="6" FontSize="12" Click="BtnGuardarSessao_Click"/>
                    </StackPanel>
                </Border>

                <!-- Base de Dados -->
                <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Configuracoes da Base de Dados" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Servidor" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtServidorBd" PlaceholderText="localhost" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Porta" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtPortaBd" PlaceholderText="5432" Padding="10,8"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Nome da Base de Dados" FontSize="12" Foreground="#64748B"/>
                            <TextBox Name="TxtNomeBd" PlaceholderText="listatelefonica" Padding="10,8"/>
                        </StackPanel>
                        <Button Name="BtnGuardarBd" Content="Guardar Configuracoes da BD" Background="#1B5E8A" 
                                Foreground="White" Padding="14,10" CornerRadius="6" FontSize="12" Click="BtnGuardarBd_Click"/>
                    </StackPanel>
                </Border>

                <Border Name="BorderMensagem" Background="#FEF2F2" BorderBrush="#FCA5A5" 
                        BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                    <TextBlock Name="TxtMensagem" Foreground="#DC2626" FontSize="12"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>