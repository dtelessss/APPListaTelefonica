<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppListaTelefonica.Views.RegistoWindow"
        Title="Criar Conta - ListaTel"
        Width="420" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#1B5E8A" CornerRadius="7" Width="32" Height="32">
                    <TextBlock Text="LT" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
                <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Foreground="#111827">
                    Lista<Run Foreground="#1B5E8A" FontWeight="Bold">Tel</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Formulário -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="40,25" Spacing="16" VerticalAlignment="Center">
                
                <StackPanel Spacing="4">
                    <TextBlock Text="Criar Conta" FontSize="22" FontWeight="Medium" Foreground="#111827"/>
                    <TextBlock Text="Registe-se com o seu email profissional" FontSize="13" Foreground="#6B7280"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Email profissional" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                        <TextBox Name="TxtEmail" PlaceholderText="exemplo@organizacao.pt" 
                                 Padding="12,10" BorderThickness="0" Background="Transparent"/>
                    </Border>
                    <TextBlock Text="Apenas emails profissionais (exclui Gmail, Yahoo, Outlook pessoal)" 
                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Palavra-passe" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                        <TextBox Name="TxtPassword" PasswordChar="●" 
                                 PlaceholderText="••••••••••••" Padding="12,10" 
                                 BorderThickness="0" Background="Transparent"/>
                    </Border>
                    <TextBlock Text="Minimo 12 caracteres, incluir 3 de 4: minusculas, maiusculas, numeros, caracteres especiais" 
                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Confirmar Password -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Confirmar palavra-passe" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                        <TextBox Name="TxtConfirmarPassword" PasswordChar="●" 
                                 PlaceholderText="••••••••••••" Padding="12,10" 
                                 BorderThickness="0" Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Unidade Organica -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Unidade Organica (opcional)" FontSize="12" FontWeight="Medium" Foreground="#374151"/>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="White">
                        <TextBox Name="TxtUnidadeOrganica" PlaceholderText="Ex: Departamento de TI" 
                                 Padding="12,10" BorderThickness="0" Background="Transparent"/>
                    </Border>
                </StackPanel>

                <!-- Mensagens -->
                <Border Name="BorderErro" Background="#FEF2F2" BorderBrush="#FCA5A5" 
                        BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                    <TextBlock Name="TxtErro" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                </Border>
                <Border Name="BorderSucesso" Background="#F0FDF4" BorderBrush="#86EFAC" 
                        BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                    <TextBlock Name="TxtSucesso" Foreground="#16A34A" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Botoes -->
                <StackPanel Spacing="10">
                    <Button Name="BtnRegistar" Content="Criar Conta" Background="#1B5E8A" 
                            Foreground="White" Padding="14,10" FontWeight="Medium" FontSize="13"
                            CornerRadius="6" Click="BtnRegistar_Click"/>
                    
                    <Button Name="BtnCancelar" Content="Voltar" Background="Transparent" 
                            Foreground="#374151" Padding="14,10" FontSize="13"
                            BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" 
                            Click="BtnCancelar_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>