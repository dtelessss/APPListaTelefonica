<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppListaTelefonica.Views.MainWindow"
        Title="ListaTel"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">

    <Grid RowDefinitions="Auto, *">
        
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#1B5E8A" CornerRadius="7" Width="32" Height="32">
                        <TextBlock Text="📖" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Foreground="#111827">
                        Lista<Run Foreground="#1B5E8A" FontWeight="Bold">Tel</Run>
                    </TextBlock>
                    <Border Background="#F3F4F6" CornerRadius="20" Padding="9,2" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock Text="Lista Pública" FontSize="11" Foreground="#4B5563"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Iniciar Sessão" Background="Transparent" Foreground="#374151" Padding="13,5" BorderBrush="#D1D5DB" BorderThickness="1"/>
                    <Button Content="Criar Conta" Background="#1B5E8A" Foreground="White" Padding="13,5" FontWeight="Medium"/>
                </StackPanel>
                <Grid /> 
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0" Padding="0" TabStripPlacement="Top">
            
            <TabItem Header="Lista Pública" FontSize="13" Padding="16,10">
                <ScrollViewer Padding="24">
                    <StackPanel Spacing="20">
                        
                        <StackPanel Spacing="4" Margin="0,10,0,10">
                            <TextBlock Text="DIRETÓRIO CORPORATIVO" FontSize="11" FontWeight="Medium" Foreground="#1B5E8A" LetterSpacing="1"/>
                            <TextBlock Text="Encontre os contactos da organização" FontSize="24" FontWeight="Medium" Foreground="#111827"/>
                            <TextBlock Text="Pesquise por nome, unidade orgânica ou número interno" FontSize="14" Foreground="#6B7280"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, Auto, Auto" Gap="12">
                            <TextBox Grid.Column="0" Watermark="Pesquisar por funcionário..." 
                                     Name="SearchInput" InnerLeftContent="🔍  " Padding="10,9" 
                                     VerticalAlignment="Center" TextChanged="SearchInput_TextChanged"/>
                            
                            <ComboBox Grid.Column="1" Width="220" SelectedIndex="0" Name="UnitFilter" 
                                      VerticalAlignment="Center" SelectionChanged="UnitFilter_SelectionChanged">
                                <ComboBoxItem Content="Todas as unidades orgânicas"/>
                                <ComboBoxItem Content="Recursos Humanos"/>
                                <ComboBoxItem Content="DataCenter"/>
                                <ComboBoxItem Content="Tecnologias de Informação"/>
                                <ComboBoxItem Content="Financeiro"/>
                            </ComboBox>
                            
                            <Button Grid.Column="2" Content="Buscar" Background="#1B5E8A" Foreground="White" Padding="20,9" Click="SearchButton_Click"/>
                        </Grid>

                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <StackPanel>
                                <Border Background="#F9FAFB" Padding="16,10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock Text="Resultados da Lista Pública" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="#E5E7EB" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="TxtContador" Text="0 contactos" FontSize="12" Foreground="#4B5563"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                                
                                <DataGrid Name="GridContactos" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*"/>
                                        <DataGridTextColumn Header="Unidade Orgânica" Binding="{Binding UnidadeOrganica}" Width="2*"/>
                                        <DataGridTextColumn Header="N.º Interno" Binding="{Binding NumeroInterno}" Width="1*"/>
                                        <DataGridTextColumn Header="Telemóveis" Binding="{Binding NumerosContactoFormatados}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Emails" Binding="{Binding EmailsFormatados}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lista Privada" FontSize="13" Padding="16,10">
                <TextBlock Text="🔒 Inicie sessão para aceder à sua lista telefónica privada." Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
            
        </TabControl>
    </Grid>
</Window>
