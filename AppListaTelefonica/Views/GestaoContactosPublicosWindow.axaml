<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:AppListaTelefonica.Models"
        x:Class="AppListaTelefonica.Views.GestaoContactosPublicosWindow"
        Title="Gerir Contactos Publicos - ListaTel"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *">
        
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Gestao de Contactos Publicos" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Name="BtnVoltar" Content="Voltar" Background="Transparent" 
                        Foreground="#475569" Padding="12,8" BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="6" FontSize="12" Click="BtnVoltar_Click"/>
            </DockPanel>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Spacing="12">
                <TextBlock Text="Adicionar Contacto" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="12">
                    <TextBox Grid.Column="0" Name="TxtNome" PlaceholderText="Nome" Padding="10,8"/>
                    <TextBox Grid.Column="1" Name="TxtEmail" PlaceholderText="Email" Padding="10,8"/>
                    <TextBox Grid.Column="2" Name="TxtNumeroInterno" PlaceholderText="N Interno" Padding="10,8"/>
                    <TextBox Grid.Column="3" Name="TxtTelemovel" PlaceholderText="Telemovel" Padding="10,8"/>
                </Grid>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0" Name="TxtUnidadeOrganica" PlaceholderText="Unidade Organica" Padding="10,8"/>
                    <Button Grid.Column="1" Name="BtnAdicionar" Content="Adicionar" Background="#1B5E8A" 
                            Foreground="White" Padding="20,8" CornerRadius="6" FontSize="12" Click="BtnAdicionar_Click"/>
                </Grid>
                <Border Name="BorderMensagem" Background="#FEF2F2" BorderBrush="#FCA5A5" 
                        BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="False">
                    <TextBlock Name="TxtMensagem" Foreground="#DC2626" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tabela -->
        <ScrollViewer Grid.Row="2" Margin="24">
            <Border Background="White" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Name="TxtContador" Text="0 contactos" FontSize="12" Foreground="#64748B"/>
                    <DataGrid Name="GridContactos" AutoGenerateColumns="False" IsReadOnly="True" 
                              GridLinesVisibility="Horizontal" x:DataType="models:ContactoPublico">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="1.5*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTextColumn Header="N Interno" Binding="{Binding NumeroInterno}" Width="1*"/>
                            <DataGridTextColumn Header="Telemovel" Binding="{Binding Telemovel}" Width="1.5*"/>
                            <DataGridTextColumn Header="U. Organica" Binding="{Binding UnidadeOrganica}" Width="1.5*"/>
                                <DataGridTemplateColumn Header="Acoes" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:ContactoPublico">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Editar" Background="#3B82F6" Foreground="White" 
                                                    Padding="8,4" CornerRadius="4" FontSize="11"
                                                    Click="BtnEditar_Click" Tag="{Binding Id}"/>
                                                <Button Content="Eliminar" Background="#EF4444" Foreground="White" 
                                                    Padding="8,4" CornerRadius="4" FontSize="11"
                                                    Click="BtnEliminar_Click" Tag="{Binding Id}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>