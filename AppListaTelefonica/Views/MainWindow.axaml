<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:AppListaTelefonica.Models"
        x:Class="AppListaTelefonica.Views.MainWindow"
        Title="ListaTel"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="7" Width="32" Height="32">
                        <TextBlock Text="LT" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <TextBlock FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Foreground="#111827">
                        Lista<Run Foreground="#1B5E8A" FontWeight="Bold">Tel</Run>
                    </TextBlock>
                    <Border Background="#F1F5F9" CornerRadius="20" Padding="9,2" VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock Text="Directorio Corporativo" FontSize="11" Foreground="#64748B"/>
                    </Border>
                </StackPanel>

                <!-- Painel de autenticacao -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    
                    <!-- Visitante -->
                    <StackPanel Name="PanelVisitante" Orientation="Horizontal" Spacing="8">
                        <Button Name="BtnLogin" Content="Iniciar Sessao" Background="Transparent" 
                                Foreground="#475569" Padding="13,8" BorderBrush="#CBD5E1" 
                                BorderThickness="1" CornerRadius="6" FontSize="12" Click="BtnLogin_Click"/>
                        <Button Name="BtnCriarConta" Content="Criar Conta" Background="#1B5E8A" 
                                Foreground="White" Padding="13,8" CornerRadius="6" FontSize="12" 
                                FontWeight="Medium" Click="BtnCriarConta_Click"/>
                    </StackPanel>
                    
                    <!-- Utilizador logado -->
                    <StackPanel Name="PanelUtilizadorLogado" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Name="TxtUtilizadorLogado" VerticalAlignment="Center" 
                                   Foreground="#475569" FontSize="13"/>
                        <Button Name="BtnAdminDashboard" Content="Painel Admin" Background="#0F172A" 
                                Foreground="White" Padding="10,5" CornerRadius="6" FontSize="12"
                                Click="BtnAdminDashboard_Click" IsVisible="False"/>
                        <Button Name="BtnLogout" Content="Sair" Background="Transparent" 
                                Foreground="#EF4444" Padding="10,5" BorderBrush="#FCA5A5" 
                                BorderThickness="1" CornerRadius="6" FontSize="12" Click="BtnLogout_Click"/>
                    </StackPanel>
                </StackPanel>
                
                <Grid /> 
            </DockPanel>
        </Border>

        <!-- Conteudo -->
        <TabControl Grid.Row="1" Margin="0" Padding="0" TabStripPlacement="Top" Background="Transparent">
            
            <!-- Tab Lista Publica -->
            <TabItem Header="Lista Publica" FontSize="13" Padding="16,10">
                <ScrollViewer Padding="24">
                    <StackPanel Spacing="20">
                        
                        <StackPanel Spacing="4" Margin="0,10,0,10">
                            <TextBlock Text="DIRECTORIO CORPORATIVO" FontSize="11" FontWeight="Medium" 
                                       Foreground="#1B5E8A" LetterSpacing="1"/>
                            <TextBlock Text="Encontre os contactos da organizacao" FontSize="24" 
                                       FontWeight="Medium" Foreground="#0F172A"/>
                            <TextBlock Text="Pesquise por nome, unidade organica ou numero interno" 
                                       FontSize="14" Foreground="#64748B"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                            <TextBox Grid.Column="0" PlaceholderText="Pesquisar por funcionario..." 
                                     Name="SearchInput" Padding="12,10" VerticalAlignment="Center"
                                     TextChanged="SearchInput_TextChanged"/>
                            
                            <ComboBox Grid.Column="1" Width="220" SelectedIndex="0" Name="UnitFilter" 
                                      VerticalAlignment="Center" SelectionChanged="UnitFilter_SelectionChanged">
                                <ComboBoxItem Content="Todas as unidades organicas"/>
                                <ComboBoxItem Content="Recursos Humanos"/>
                                <ComboBoxItem Content="DataCenter"/>
                                <ComboBoxItem Content="Tecnologias de Informacao"/>
                                <ComboBoxItem Content="Financeiro"/>
                            </ComboBox>
                            
                            <Button Grid.Column="2" Content="Buscar" Background="#1B5E8A" Foreground="White" 
                                    Padding="20,9" CornerRadius="6" FontSize="12" Click="SearchButton_Click"/>
                        </Grid>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Background="#F8FAFC" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock Text="Resultados da Lista Publica" FontWeight="SemiBold" 
                                                   Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="#E2E8F0" CornerRadius="10" Padding="8,4">
                                            <TextBlock Name="TxtContador" Text="0 contactos" FontSize="12" Foreground="#64748B"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                                
                                <DataGrid Name="GridContactos" AutoGenerateColumns="False" 
                                          IsReadOnly="True" GridLinesVisibility="Horizontal" 
                                          x:DataType="models:ContactoPublico">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*"/>
                                        <DataGridTextColumn Header="Unidade Organica" Binding="{Binding UnidadeOrganica}" Width="1.5*"/>
                                        <DataGridTextColumn Header="N Interno" Binding="{Binding NumeroInterno}" Width="1*"/>
                                        <DataGridTextColumn Header="Telemovel" Binding="{Binding Telemovel}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab Lista Privada -->
            <TabItem Name="TabPrivada" Header="Lista Privada" FontSize="13" Padding="16,10" IsVisible="False">
                <ScrollViewer Padding="24">
                    <StackPanel Spacing="20">
                        
                        <StackPanel Spacing="4" Margin="0,10,0,10">
                            <TextBlock Text="LISTA PRIVADA" FontSize="11" FontWeight="Medium" 
                                       Foreground="#8B5CF6" LetterSpacing="1"/>
                            <TextBlock Text="Os seus contactos privados" FontSize="24" 
                                       FontWeight="Medium" Foreground="#0F172A"/>
                            <TextBlock Text="Crie e gira a sua lista pessoal de contactos" 
                                       FontSize="14" Foreground="#64748B"/>
                        </StackPanel>

                        <!-- Toolbar -->
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                            <TextBox Grid.Column="0" PlaceholderText="Pesquisar contactos privados..." 
                                     Name="SearchPrivado" Padding="12,10"/>
                            <ComboBox Grid.Column="1" Width="200" Name="FiltroIdentificador" 
                                      VerticalAlignment="Center" SelectionChanged="FiltroIdentificador_SelectionChanged"/>
                            <Button Grid.Column="2" Content="Novo Contacto" Background="#1B5E8A" 
                                    Foreground="White" Padding="20,9" CornerRadius="6" FontSize="12"
                                    Click="BtnNovoContactoPrivado_Click"/>
                        </Grid>

                        <!-- Botoes de identificadores -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="BtnGerirIdentificadores" Content="Gerir Identificadores" 
                                    Background="Transparent" Foreground="#475569" Padding="12,8" 
                                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" FontSize="12"
                                    Click="BtnGerirIdentificadores_Click"/>
                            <Button Name="BtnEliminarLista" Content="Eliminar Lista Privada" 
                                    Background="Transparent" Foreground="#EF4444" Padding="12,8" 
                                    BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" FontSize="12"
                                    Click="BtnEliminarLista_Click"/>
                        </StackPanel>

                        <!-- Tabela contactos privados -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Background="#F8FAFC" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock Text="Contactos Privados" FontWeight="SemiBold" 
                                                   Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="#E2E8F0" CornerRadius="10" Padding="8,4">
                                            <TextBlock Name="TxtContadorPrivado" Text="0 contactos" FontSize="12" Foreground="#64748B"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                                
                                <DataGrid Name="GridContactosPrivados" AutoGenerateColumns="False" 
                                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          x:DataType="models:ContactoPrivado">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                                        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="1.5*"/>
                                        <DataGridTextColumn Header="N Interno" Binding="{Binding NumeroInterno}" Width="1*"/>
                                        <DataGridTextColumn Header="Identificador" Binding="{Binding IdentificadorNome}" Width="1.5*"/>
                                        <DataGridTemplateColumn Header="Acoes" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="models:ContactoPrivado">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Editar" Background="#3B82F6" Foreground="White" 
                                                                Padding="8,4" CornerRadius="4" FontSize="11"
                                                                Click="BtnEditarPrivado_Click" Tag="{Binding Id}"/>
                                                        <Button Content="Eliminar" Background="#EF4444" Foreground="White" 
                                                                Padding="8,4" CornerRadius="4" FontSize="11"
                                                                Click="BtnEliminarPrivado_Click" Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
        </TabControl>
    </Grid>
</Window>