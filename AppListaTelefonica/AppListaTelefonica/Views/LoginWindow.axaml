<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AppListaTelefonica.Views.LoginWindow"
        Title="SGLT - Sistema Gestão Lista Telefónica"
        Width="450" Height="550"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

	<StackPanel Margin="30" Spacing="15">

		<!-- Título -->
		<TextBlock Text="SGLT" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

		<!-- Abas -->
		<TabControl x:Name="MainTabControl">

			<!-- ========== ABA LOGIN ========== -->
			<TabItem Header="Login">
				<StackPanel Spacing="15" Margin="0,15,0,0">

					<TextBlock Text="Email" FontWeight="Bold"/>
					<TextBox x:Name="LoginEmailBox" Watermark="exemplo@empresa.com"/>

					<TextBlock Text="Palavra-passe" FontWeight="Bold"/>
					<PasswordBox x:Name="LoginPasswordBox" Watermark="********"/>

					<Button x:Name="LoginButton" Content="Entrar" Background="#4F46E5" Foreground="White" Padding="10" CornerRadius="8"/>

					<Button x:Name="ForgotPasswordButton" Content="Esqueceu a palavra-passe?" Background="Transparent" Foreground="#4F46E5" Cursor="Hand"/>

					<Border x:Name="LoginErrorBorder" Background="#FEE2E2" CornerRadius="8" Padding="10" IsVisible="False">
						<TextBlock x:Name="LoginErrorText" Foreground="#DC2626" TextWrapping="Wrap"/>
					</Border>
				</StackPanel>
			</TabItem>

			<!-- ========== ABA REGISTO ========== -->
			<TabItem Header="Registo">
				<ScrollViewer Height="380">
					<StackPanel Spacing="15" Margin="0,15,0,0">

						<TextBlock Text="Email" FontWeight="Bold"/>
						<TextBox x:Name="RegEmailBox" Watermark="exemplo@empresa.com"/>

						<TextBlock Text="Palavra-passe" FontWeight="Bold"/>
						<PasswordBox x:Name="RegPasswordBox" Watermark="********"/>

						<Border Background="#F3F4F6" CornerRadius="6" Padding="8">
							<StackPanel Spacing="4">
								<ProgressBar x:Name="StrengthBar" Height="4" Minimum="0" Maximum="100" Value="0"/>
								<TextBlock x:Name="StrengthText" FontSize="10" Foreground="#6B7280"/>
							</StackPanel>
						</Border>

						<TextBlock Text="Confirmar palavra-passe" FontWeight="Bold"/>
						<PasswordBox x:Name="RegConfirmPasswordBox" Watermark="********"/>

						<TextBlock Text="Unidade Orgânica" FontWeight="Bold"/>
						<TextBox x:Name="RegUnidadeBox" Watermark="Departamento / Unidade"/>

						<Button x:Name="RegisterButton" Content="Criar Conta" Background="#10B981" Foreground="White" Padding="10" CornerRadius="8"/>

						<Border x:Name="RegErrorBorder" Background="#FEE2E2" CornerRadius="8" Padding="10" IsVisible="False">
							<TextBlock x:Name="RegErrorText" Foreground="#DC2626" TextWrapping="Wrap"/>
						</Border>

						<Border x:Name="RegSuccessBorder" Background="#D1FAE5" CornerRadius="8" Padding="10" IsVisible="False">
							<TextBlock x:Name="RegSuccessText" Foreground="#059669" TextWrapping="Wrap"/>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</StackPanel>
</Window>